  m_Script: {fileID: 11500000, guid: ef3043b17d54949e7a434fc7c69b7249, type: 3}
  m_Name: Ada_Lines
  m_EditorClassIdentifier: Assembly-CSharp::NpcLines
  nameColor: {r: 1, g: 0.55, b: 0.35, a: 1}
  voicePitch: 1
  greeting: Careful, wet paint! I'm Ada. I build the boats around here.
  lines:
  - The best fish aren't near the shore. You'll need a boat for those.
  - Bring me enough coins and I'll build you something that floats. Guaranteed. Mostly.
  - A bigger boat means deeper water. Deeper water means bigger fish.
  - Every plank on that dock? Hammered in by yours truly.
  - Wood, nails and a bit of stubbornness. That's all a good boat needs.
