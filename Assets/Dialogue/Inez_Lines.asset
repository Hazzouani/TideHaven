  m_Script: {fileID: 11500000, guid: ef3043b17d54949e7a434fc7c69b7249, type: 3}
  m_Name: Inez_Lines
  m_EditorClassIdentifier: Assembly-CSharp::NpcLines
  nameColor: {r: 0.85, g: 0.55, b: 1, a: 1}
  voicePitch: 1.15
  greeting: Oh, a customer! I'm Inez. Every rod on this island has passed through my hands.
  lines:
  - That driftwood rod won't hold anything heavy. Come back when you have 250 coins.
  - The Pearl Tide rod was made by the sea itself. Or so I tell people.
  - Frost, fire, shadow... every rod has its own story. And its own price.
  - The Celestial rod? Thirty thousand coins. Worth every star on it.
  - A better rod casts further and lands bigger fish. Simple economics.
